# ==================================================================
# Smart Serve MOBILE app (Expo) — build-time environment
# ==================================================================
# Copy to .env (or set these in the EAS dashboard / eas.json) BEFORE
# running `eas build`. EXPO_PUBLIC_* values are inlined into the app
# at build time and are PUBLIC by design — never put secrets here.
#
# NEVER put in this file (backend-only secrets):
#   GEMINI_API_KEY, RAZORPAY_KEY_SECRET, STRIPE_SECRET_KEY,
#   GOOGLE_CLIENT_SECRET, SMTP_PASSWORD, DATABASE_PASSWORD, JWT_SECRET

# Deployed SmartServe backend origin (HTTPS). Must NOT be localhost /
# 127.0.0.1 / 192.168.x.x / 10.0.2.2.
EXPO_PUBLIC_API_URL=https://your-deployed-backend.example.com

# Google "Maps SDK for Android" API key — required for the map screens
# (location picker + live tracking) on real Android devices.
# Leave unset for dev/web; set it as an EAS secret for device builds.
EXPO_PUBLIC_ANDROID_MAPS_API_KEY=
