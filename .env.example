# ==================================================================
# SmartServe environment configuration
# Copy to .env and fill in the values you need.
# Every variable below is OPTIONAL except PORT and DATABASE_URL -
# the application gracefully degrades when a service is unconfigured
# (no Gemini key -> heuristic AI engine, no Razorpay -> sandbox
# payments, no SMTP -> in-app dev outbox, no Google OAuth -> hidden
# button, no Maps key -> OpenStreetMap tiles).
# NEVER commit real secrets.
# ==================================================================

# ---- Server -------------------------------------------------------
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed CORS origins (empty = allow all,
# fine for local dev; lock this down in production)
CORS_ORIGIN=
# Structured logging level
LOG_LEVEL=info

# ---- Database -----------------------------------------------------
# PostgreSQL connection string.
# For zero-setup local development run `pnpm pg:dev` (embedded
# Postgres) and keep the default below.
DATABASE_URL=postgres://smartserve:smartserve@127.0.0.1:5432/smartserve

# ---- Demo / seed mode ----------------------------------------------
# Seeds demo users/providers/bookings (clearly labeled) when the
# database is empty. Set false for production.
DEMO_MODE=true

# ---- AI - Google Gemini ---------------------------------------------
# Get a key at https://aistudio.google.com/apikey
# When empty, SmartServe uses its built-in rule-based engine and
# clearly labels results as heuristic estimates.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---- Google OAuth -----------------------------------------------------
# Create OAuth credentials in Google Cloud Console (authorized
# redirect URI: https://<your-domain>/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Payments - Razorpay ------------------------------------------------
# Test keys: https://dashboard.razorpay.com/app/keys
# When empty, a clearly-labeled sandbox gateway is used (real order
# creation, server-side verification, refunds - no real money).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_CURRENCY=INR

# ---- Email - SMTP ----------------------------------------------------------
# When empty, outgoing mail is written to a visible dev outbox instead
# of crashing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=SmartServe <no-reply@smartserve.local>

# ---- Maps --------------------------------------------------------------------
# Optional Google Maps key. The live-tracking map defaults to
# OpenStreetMap tiles which need no key.
MAPS_API_KEY=

# ---- Matching engine -----------------------------------------------------------
# Seconds a provider has to respond to a request before it is re-broadcast
REQUEST_TIMEOUT_SEC=45
# How many widening radius batches the matcher runs before expiring
MAX_MATCH_BATCHES=3
# Providers notified per batch
MATCH_BATCH_SIZE=5

# ---- Uploads ----------------------------------------------------------------------
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# ==================================================================
# MOBILE APP (artifacts/smart-serve, Expo) — build-time variables
# ==================================================================
# These are inlined into the mobile app at BUILD time (EAS) and are
# PUBLIC by design. Set them in artifacts/smart-serve/.env or in the
# eas.json profiles / EAS dashboard. NEVER put secrets here — see
# artifacts/smart-serve/.env.example.
#
# EXPO_PUBLIC_API_URL            deployed backend origin (HTTPS)
# EXPO_PUBLIC_ANDROID_MAPS_API_KEY  Google Maps SDK for Android key
